{
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },

  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "jsdoc",
    "node",
    "promise",
    "vitest"
  ],

  "rules": {
    "filename-case": "off",
    "sort-keys": "off",
    "max-lines-per-function": "off",
    "func-style": "off",
    "max-depth": "off",
    "sort-imports": "off",
    "max-nested-callbacks": "off",
    "no-magic-numbers": "off",
    "no-duplicate-imports": "off",
    "no-async-await": "off",
    "no-optional-chaining": "off",
    "no-void": "off",
    "max-lines": "off",

    "no-console": ["error", { "allow": ["error"] }]
  }
}
